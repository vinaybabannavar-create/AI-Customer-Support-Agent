# Copy to .env and fill in, or export directly in your shell.
# If neither key below is set, the pipeline runs in MOCK MODE (deterministic
# keyword heuristics instead of real LLM calls) so it's still fully runnable
# -- see src/llm_client.py and README "Running without an API key".

# Pick ONE provider:
LLM_PROVIDER=gemini
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=xai
# LLM_PROVIDER=groq

# --- Gemini (has a free tier) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (pay-as-you-go) ---
ANTHROPIC_API_KEY=sk-ant-...
HIVER_MODEL=claude-sonnet-4-6

# --- xAI / Grok (OpenAI-compatible API) ---
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.6

# --- Groq (OpenAI-compatible API) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
